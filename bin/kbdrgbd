#!/usr/bin/env python3
"""kbdrgbd - drives the ASUS ITE5570 keyboard LampArray.

LampArray has no onboard effects: anything animated needs a process pushing
frames. This daemon owns the device, renders from ~/.config/kbdrgb/state.json,
and reloads whenever that file changes. Clients just write the file.

Also re-applies on resume, since the firmware reclaims the LEDs across suspend.
"""
import colorsys, fcntl, glob, json, os, struct, sys
import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

HID_IDS = (0x0B05, 0x5570)      # the ITE5570 keyboard controller
STATE = os.path.expanduser("~/.config/kbdrgb/state.json")
DEFAULT = {"mode": "solid", "color": [0, 170, 255], "intensity": 255,
           "seconds": 8.0, "fps": 30}
RETRY_SECONDS = 3


def find_device():
    """Resolve the keyboard's hidraw node by HID identity, not by node number.

    hidraw numbering is enumeration order and is not stable: a USB mouse left
    plugged in across a reboot enumerates first and shifts the keyboard along.
    Matching on the ID also stops us writing LampArray reports into whatever
    unrelated device happens to hold the old number.
    """
    for sysdir in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            with open(os.path.join(sysdir, "device", "uevent")) as fh:
                fields = dict(l.split("=", 1) for l in fh.read().splitlines() if "=" in l)
        except OSError:
            continue
        parts = fields.get("HID_ID", "").split(":")
        try:
            if len(parts) == 3 and (int(parts[1], 16), int(parts[2], 16)) == HID_IDS:
                return "/dev/" + os.path.basename(sysdir)
        except ValueError:
            continue
    return None


class Lamp:
    STD = ("standard", 0x45, 0x46)
    VND = ("vendor",   0x35, 0x36)

    def __init__(self):
        self.fd = self.path = self.proto = None
        self.complained = None

    def _warn_once(self, key, msg):
        if self.complained != key:          # the device can be absent for a while
            print(f"kbdrgbd: {msg}", file=sys.stderr)
            self.complained = key

    def open(self):
        """Bind to the keyboard, returning True once we hold a usable fd."""
        if self.fd is not None:
            return True
        path = find_device()
        if path is None:
            self._warn_once("absent", "keyboard (0B05:5570) not present - waiting")
            return False
        try:
            self.fd = open(path, "rb+")
        except PermissionError:
            self._warn_once("perm", f"{path} is the keyboard but is not writable "
                                    "- is the udev rule installed?")
            return False
        except OSError as e:
            self._warn_once("io", f"cannot open {path}: {e}")
            return False
        if self.complained or self.path != path:
            print(f"kbdrgbd: using {path}", file=sys.stderr)
        self.path, self.proto, self.complained = path, None, None
        return True

    def close(self):
        if self.fd is not None:
            try:
                self.fd.close()
            except OSError:
                pass
        self.fd = self.proto = None

    def _write(self, payload):
        buf = bytearray(payload)
        fcntl.ioctl(self.fd, (3 << 30) | (len(buf) << 16) | (ord('H') << 8) | 0x06, buf)

    def _send_rgb(self, r, g, b, intensity):
        for proto in ([self.proto] if self.proto else [self.STD, self.VND]):
            try:
                if self.proto is None:
                    self._write(struct.pack("<BB", proto[2], 0))   # autonomous off
                self._write(struct.pack("<BBHHBBBB", proto[1], 0x01, 0, 0,
                                        r, g, b, intensity))
                self.proto = proto
                return
            except OSError:
                continue
        raise OSError("device rejected both standard and vendor report sets")

    def set_rgb(self, r, g, b, intensity=255):
        for last in (False, True):      # a node that went away is worth one re-resolve
            if not self.open():
                raise OSError("keyboard not available")
            try:
                return self._send_rgb(r, g, b, intensity)
            except OSError:
                self.close()
                if last:
                    raise

    def autonomous(self, on):
        if not self.open():
            raise OSError("keyboard not available")
        try:
            self._write(struct.pack("<BB", (self.proto or self.STD)[2], 1 if on else 0))
        except OSError:
            self.close()
            raise
        if on:
            self.proto = None      # firmware owns it again; re-probe on next set


class Daemon:
    def __init__(self):
        self.lamp = Lamp()
        self.state = dict(DEFAULT)
        self.phase = 0.0
        self.tick = None
        self.retry = None
        self.load()

        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        f = Gio.File.new_for_path(STATE)
        self.mon = f.monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.mon.connect("changed", self.on_changed)

        # logind tells us when we come back from suspend
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            bus.signal_subscribe("org.freedesktop.login1",
                                 "org.freedesktop.login1.Manager", "PrepareForSleep",
                                 "/org/freedesktop/login1", None,
                                 Gio.DBusSignalFlags.NONE, self.on_sleep, None)
        except GLib.Error as e:
            print(f"kbdrgbd: no logind signal ({e.message}); resume won't re-apply",
                  file=sys.stderr)

    def load(self):
        try:
            with open(STATE) as fh:
                self.state = {**DEFAULT, **json.load(fh)}
        except (OSError, ValueError):
            pass

    def on_changed(self, mon, f, other, event):
        if event in (Gio.FileMonitorEvent.CHANGES_DONE_HINT,
                     Gio.FileMonitorEvent.CREATED):
            self.load()
            self.render()

    def on_sleep(self, *args):
        going_to_sleep = args[-2][0] if isinstance(args[-2], GLib.Variant) else True
        if not going_to_sleep:                 # False == just resumed
            self.lamp.close()                  # re-resolve, then redo the handshake
            GLib.timeout_add(1200, lambda: (self.render(), False)[1])

    def fps(self):
        return min(max(int(self.state.get("fps", 30)), 1), 120)

    def push(self, r, g, b):
        try:
            self.lamp.set_rgb(r, g, b, int(self.state.get("intensity", 255)))
            return True
        except OSError as e:
            print(f"kbdrgbd: {e}", file=sys.stderr)
            self.schedule_retry()
            return False

    def stop_tick(self):
        if self.tick:
            GLib.source_remove(self.tick)
            self.tick = None

    def schedule_retry(self):
        """Wait for the keyboard instead of exiting; systemd restarts are no cure
        for a device that simply is not there yet."""
        self.stop_tick()
        if self.retry is None:
            self.retry = GLib.timeout_add_seconds(
                RETRY_SECONDS, lambda: (setattr(self, "retry", None),
                                        self.render(), False)[-1])

    def render(self):
        self.stop_tick()
        mode = self.state.get("mode", "solid")
        if mode == "wave":
            if self.push(*self.wave_rgb(advance=False)):     # confirm before ticking
                self.tick = GLib.timeout_add(1000 // self.fps(), self.on_tick)
        elif mode == "off":
            self.push(0, 0, 0)
        elif mode == "auto":
            try:
                self.lamp.autonomous(True)
            except OSError as e:
                print(f"kbdrgbd: {e}", file=sys.stderr)
                self.schedule_retry()
        else:
            self.push(*[int(c) for c in self.state.get("color", DEFAULT["color"])])

    def wave_rgb(self, advance=True):
        if advance:
            secs = max(float(self.state.get("seconds", 8.0)), 0.1)
            self.phase = (self.phase + (1 / self.fps()) / secs) % 1.0
        return [int(v * 255) for v in colorsys.hsv_to_rgb(self.phase, 1, 1)]

    def on_tick(self):
        if not self.push(*self.wave_rgb()):
            self.tick = None            # schedule_retry already stopped us
            return GLib.SOURCE_REMOVE
        return GLib.SOURCE_CONTINUE


d = Daemon()
d.render()
loop = GLib.MainLoop()
for sig in ("SIGTERM", "SIGINT"):
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, getattr(__import__("signal"), sig),
                         lambda: (loop.quit(), GLib.SOURCE_REMOVE)[1])
loop.run()
